<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Study Buddy — AI Learning Assistant</title>
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#14213D" />
<link rel="apple-touch-icon" href="/icon-192.png" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Study Buddy" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
<style>
  :root{
    --bg:#EEF1F6; --surface:#FFFFFF; --ink:#14213D; --ink-soft:rgba(20,33,61,0.62);
    --primary:#14213D; --primary-hover:#1D2E52; --accent:#0F766E; --accent-soft:rgba(15,118,110,0.08);
    --gold:#CA8A04; --gold-soft:rgba(202,138,4,0.12); --danger:#DC2626; --danger-soft:rgba(220,38,38,0.08);
    --success:#059669; --success-soft:rgba(5,150,105,0.10); --border:rgba(20,33,61,0.10);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Inter', -apple-system, Segoe UI, Roboto, sans-serif; background: var(--bg); color: var(--ink); }
  .shell { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 18px; }
  .card { width: 100%; max-width: 430px; background: var(--surface); border-radius: 20px; box-shadow: 0 1px 2px rgba(16,24,40,0.04), 0 12px 32px rgba(16,24,40,0.10); border: 1px solid var(--border); overflow: hidden; }
  .content { padding: 28px 24px; }
  h1 { font-weight: 800; font-size: 22px; color: var(--ink); margin: 0 0 4px; letter-spacing: -0.01em; }
  .sub { color: var(--ink-soft); font-size: 13.5px; margin-bottom: 20px; line-height: 1.5; }
  .option { width: 100%; text-align: left; padding: 14px 16px; background: #FAFBFC; border: 1px solid var(--border); border-radius: 12px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-size: 15px; color: var(--ink); font-weight: 600; margin-bottom: 10px; transition: all .15s ease; font-family: inherit; }
  .option:hover { border-color: var(--accent); background: var(--accent-soft); transform: translateY(-1px); }
  .option:last-child { margin-bottom: 0; }
  .chev { color: var(--ink-soft); font-weight: 400; }
  .back { background: none; border: none; color: var(--ink-soft); font-size: 13px; cursor: pointer; padding: 0; font-weight: 600; font-family: inherit; }
  .primary-btn { width: 100%; padding: 13px; border-radius: 12px; border: none; background: var(--primary); color: white; font-weight: 700; font-size: 15px; cursor: pointer; font-family: inherit; transition: background .15s; }
  .primary-btn:hover { background: var(--primary-hover); }
  .primary-btn:disabled { opacity: .5; cursor: default; }
  .textinput { width: 100%; padding: 12px 14px; border-radius: 10px; border: 1.5px solid var(--border); font-size: 14px; font-family: inherit; margin-top: 4px; }
  .textinput:focus { outline: none; border-color: var(--accent); }
  .plans { display: flex; flex-direction: column; gap: 14px; }
  .plancard { border: 1.5px solid var(--border); border-radius: 16px; padding: 18px; background: #FAFBFC; }
  .plancard.highlight { border: 1.5px solid var(--accent); background: var(--accent-soft); position: relative; }
  .plancard h3 { margin: 0 0 4px; color: var(--ink); font-size: 16px; font-weight: 800; }
  .plancard .price { color: var(--accent); font-weight: 700; font-size: 14px; margin-bottom: 10px; }
  .plancard ul { margin: 0 0 12px; padding-left: 18px; color: var(--ink-soft); font-size: 13px; }
  .plancard li { margin-bottom: 4px; }
  .plancard button { width: 100%; padding: 11px; border-radius: 10px; border: none; background: var(--primary); color: white; font-weight: 700; cursor: pointer; font-family: inherit; font-size: 14px; }
  .paybox { background: var(--gold-soft); border: 1px solid rgba(202,138,4,0.25); border-radius: 10px; padding: 12px; font-size: 12.5px; color: var(--ink); margin-top: 10px; line-height: 1.5; }
  .codeinput { width: 100%; padding: 11px 12px; border-radius: 10px; border: 1.5px solid var(--border); margin-top: 10px; font-size: 14px; font-family: inherit; }
  .limitnote { font-size: 12px; color: var(--ink-soft); text-align: center; padding: 8px; background: #FAFBFC; }
  .chatwrap { display: flex; flex-direction: column; height: 84vh; max-height: 660px; }
  .topbar { background: var(--primary); color: white; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; font-size: 14px; }
  .coinpill { font-size: 12px; background: var(--gold-soft); color: var(--gold); padding: 4px 10px; border-radius: 20px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; }
  .planpill { font-size: 10.5px; background: rgba(255,255,255,0.15); color: white; padding: 3px 9px; border-radius: 20px; font-weight: 700; letter-spacing: .03em; }
  .chatbody { flex: 1; overflow-y: auto; padding: 18px; background: #F7F8FA; }
  .bubble { max-width: 82%; padding: 11px 15px; border-radius: 16px; font-size: 14px; line-height: 1.55; margin-bottom: 12px; white-space: pre-wrap; }
  .user { background: var(--primary); color: white; margin-left: auto; border-bottom-right-radius: 4px; }
  .bot { background: white; border: 1px solid var(--border); color: var(--ink); border-bottom-left-radius: 4px; }
  .inputrow { border-top: 1px solid var(--border); padding: 12px; display: flex; gap: 8px; background: white; }
  textarea { flex: 1; resize: none; border-radius: 10px; border: 1.5px solid var(--border); padding: 11px; font-size: 14px; font-family: inherit; }
  textarea:focus { outline: none; border-color: var(--accent); }
  .sendbtn { width: 44px; height: 44px; border-radius: 10px; background: var(--primary); color: white; border: none; font-size: 17px; cursor: pointer; flex-shrink:0; }
  .sendbtn:disabled { opacity: 0.4; }
  .attachbtn { width: 44px; height: 44px; border-radius: 10px; background: #FAFBFC; color: var(--ink); border: 1.5px solid var(--border); font-size: 17px; cursor: pointer; flex-shrink:0; }
  .thumb-wrap { position: relative; display: inline-block; margin: 0 0 8px 0; }
  .thumb-wrap img { max-width: 110px; border-radius: 10px; border: 1px solid var(--border); display: block; }
  .thumb-remove { position: absolute; top: -6px; right: -6px; width: 20px; height: 20px; border-radius: 50%; background: var(--danger); color: white; border: none; font-size: 12px; cursor: pointer; }
  .bubble img { max-width: 100%; border-radius: 10px; margin-top: 6px; display: block; }
  .modegrid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .modecard { border: 1.5px solid var(--border); border-radius: 16px; padding: 20px 14px; text-align: center; background: #FAFBFC; cursor: pointer; transition: all .15s; }
  .modecard:hover { border-color: var(--accent); background: var(--accent-soft); transform: translateY(-2px); }
  .modecard .icon { font-size: 26px; margin-bottom: 8px; }
  .modecard .label { font-weight: 700; font-size: 14px; color: var(--ink); }
  .modecard .desc { font-size: 11.5px; color: var(--ink-soft); margin-top: 4px; }
  .scopecard { border: 1.5px solid var(--border); border-radius: 12px; padding: 14px; margin-bottom: 10px; cursor: pointer; transition: all .15s; }
  .scopecard.active { border-color: var(--accent); background: var(--accent-soft); }
  .scopecard .t { font-weight: 700; font-size: 14px; color: var(--ink); }
  .scopecard .d { font-size: 12px; color: var(--ink-soft); margin-top: 2px; }
  .numrow { display: flex; gap: 8px; margin-top: 6px; }
  .numbtn { flex: 1; padding: 10px; border-radius: 10px; border: 1.5px solid var(--border); background: #FAFBFC; font-weight: 700; cursor: pointer; font-family: inherit; }
  .numbtn.active { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
  .quizprog { font-size: 12px; color: var(--ink-soft); font-weight: 600; margin-bottom: 10px; }
  .quizq { font-size: 16px; font-weight: 700; color: var(--ink); margin-bottom: 16px; line-height: 1.5; }
  .quizopt { width: 100%; text-align: left; padding: 13px 14px; border-radius: 12px; border: 1.5px solid var(--border); background: white; margin-bottom: 10px; font-size: 14px; cursor: pointer; font-family: inherit; color: var(--ink); font-weight: 500; }
  .quizopt.correct { border-color: var(--success); background: var(--success-soft); font-weight: 700; }
  .quizopt.wrong { border-color: var(--danger); background: var(--danger-soft); font-weight: 700; }
  .quizopt:disabled { cursor: default; }
  .coinfeedback { text-align: center; font-weight: 800; font-size: 15px; margin: 10px 0; }
  .coinfeedback.pos { color: var(--success); }
  .coinfeedback.neg { color: var(--danger); }
  .resultbig { text-align: center; font-size: 40px; font-weight: 800; color: var(--gold); margin: 6px 0; }
  .statrow { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 14px; }
  .statrow:last-child { border-bottom: none; }
  .loadingdots { display: flex; gap: 5px; padding: 4px 0; }
  .loadingdots span { width: 7px; height: 7px; border-radius: 50%; background: var(--ink-soft); animation: bounce 1s infinite; }
  .loadingdots span:nth-child(2){animation-delay:.15s} .loadingdots span:nth-child(3){animation-delay:.3s}
  @keyframes bounce { 0%,80%,100%{transform:translateY(0)} 40%{transform:translateY(-5px)} }
</style>
</head>
<body>
<div id="root"></div>
<script type="text/babel">
const { useState, useRef, useEffect } = React;

const GRADES = ["9", "10", "11", "12"];
const STREAMS = {
  "11": ["Pre-Medical (FSc)", "Pre-Engineering (FSc)", "FA (Arts)", "ICS"],
  "12": ["Pre-Medical (FSc)", "Pre-Engineering (FSc)", "FA (Arts)", "ICS"],
};
const SUBJECTS = {
  "9": ["Physics", "Chemistry", "Biology", "Mathematics", "English", "Urdu", "Pakistan Studies", "Computer Science"],
  "10": ["Physics", "Chemistry", "Biology", "Mathematics", "English", "Urdu", "Pakistan Studies", "Computer Science"],
  "Pre-Medical (FSc)": ["Physics", "Chemistry", "Biology", "English"],
  "Pre-Engineering (FSc)": ["Physics", "Chemistry", "Mathematics", "English"],
  "ICS": ["Computer Science", "Mathematics", "Physics", "English"],
  "FA (Arts)": ["Urdu", "English", "Islamiyat", "Pakistan Studies", "Economics", "Civics", "Psychology"],
};
const FREE_DAILY_LIMIT = 5;

function getSavedPhone() {
  try { return localStorage.getItem("sb_phone") || ""; } catch (e) { return ""; }
}
function savePhone(phone) {
  try { localStorage.setItem("sb_phone", phone); } catch (e) {}
}

function buildSystemPrompt(grade, stream, subject, medium) {
  const classLabel = stream ? `Grade ${grade} (${stream})` : `Grade ${grade}`;
  const languageRule = medium === "urdu"
    ? "- Always respond in Roman Urdu (Urdu written in English letters), simple and easy to read."
    : "- Always respond in clear, simple English.";
  return `You are a friendly Pakistani AI tutor helping a ${classLabel} student with ${subject}.
Rules:
${languageRule}
- Don't just give the final answer — explain step by step.
- Keep paragraphs short, this is read on a mobile screen.
- Base answers on the Pakistani board syllabus for ${subject}.
- If the question isn't related to the subject, gently steer the conversation back.`;
}

function App() {
  const [step, setStep] = useState("login");
  const [phone, setPhone] = useState("");
  const [phoneInput, setPhoneInput] = useState("");
  const [loginError, setLoginError] = useState("");
  const [checkingLogin, setCheckingLogin] = useState(false);
  const [grade, setGrade] = useState(null);
  const [medium, setMedium] = useState(null);
  const [stream, setStream] = useState(null);
  const [subject, setSubject] = useState(null);
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");
  const [image, setImage] = useState(null);
  const [loading, setLoading] = useState(false);
  const [planState, setPlanState] = useState({ plan: "free", date: "", count: 0, coins: 0 });
  const [codeInput, setCodeInput] = useState("");
  const [codeError, setCodeError] = useState("");
  const scrollRef = useRef(null);
  const fileRef = useRef(null);

  // Quiz state
  const [scopeType, setScopeType] = useState("chapter");
  const [scopeDetail, setScopeDetail] = useState("");
  const [mixedGrades, setMixedGrades] = useState([]);
  const [numQuestions, setNumQuestions] = useState(5);
  const [quizLoading, setQuizLoading] = useState(false);
  const [quizError, setQuizError] = useState("");
  const [quizQuestions, setQuizQuestions] = useState([]);
  const [quizIndex, setQuizIndex] = useState(0);
  const [quizSelected, setQuizSelected] = useState(null);
  const [quizCorrectCount, setQuizCorrectCount] = useState(0);
  const [quizWrongCount, setQuizWrongCount] = useState(0);
  const [quizSessionCoins, setQuizSessionCoins] = useState(0);
  const [coinFeedback, setCoinFeedback] = useState(null);

  const today = new Date().toDateString();
  const questionsUsedToday = planState.date === today ? planState.count : 0;
  const isPaid = planState.plan === "paid" || planState.plan === "business";
  const freeRemaining = FREE_DAILY_LIMIT - questionsUsedToday;

  useEffect(() => {
    const saved = getSavedPhone();
    if (saved) { setPhoneInput(saved); loginWithPhone(saved); }
  }, []);

  useEffect(() => {
    if (scrollRef.current) scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
  }, [messages, loading]);

  async function loginWithPhone(rawPhone) {
    const cleanPhone = rawPhone.trim().replace(/[\s-]/g, "");
    if (!cleanPhone || cleanPhone.length < 10) { setLoginError("Please enter a valid phone number."); return; }
    setCheckingLogin(true); setLoginError("");
    try {
      const response = await fetch(`/api/user?phone=${encodeURIComponent(cleanPhone)}`);
      const data = await response.json();
      if (data.success) {
        setPhone(cleanPhone); savePhone(cleanPhone); setPlanState(data.user); setStep("plans");
      } else { setLoginError(data.message || "Could not log in. Try again."); }
    } catch (e) { setLoginError("Could not connect. Check your internet and try again."); }
    finally { setCheckingLogin(false); }
  }

  function logout() {
    try { localStorage.removeItem("sb_phone"); } catch (e) {}
    setPhone(""); setPhoneInput(""); setPlanState({ plan: "free", date: "", count: 0, coins: 0 });
    setGrade(null); setStream(null); setSubject(null); setMedium(null); setMessages([]);
    setStep("login");
  }

  async function addCoins(delta) {
    setPlanState(prev => ({ ...prev, coins: (prev.coins || 0) + delta }));
    try {
      await fetch("/api/user", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone, action: "coins", delta }),
      });
    } catch (e) {}
  }

  const needsStream = grade === "11" || grade === "12";
  const subjectList = needsStream ? (SUBJECTS[stream] || []) : (SUBJECTS[grade] || []);

  function selectGrade(g) {
    setGrade(g); setStream(null); setSubject(null);
    setStep(g === "11" || g === "12" ? "stream" : "subject");
  }
  function selectStream(s) { setStream(s); setSubject(null); setStep("subject"); }
  function selectSubject(s) { setSubject(s); setStep("mode"); }

  function startChat() {
    setStep("chat");
    const greeting = medium === "urdu"
      ? `Assalam-o-Alaikum! Main tumhara ${subject} ka study buddy hoon. Grade ${grade}${stream ? " (" + stream + ")" : ""} ka koi bhi sawal poochho.`
      : `Hi! I'm your ${subject} study buddy. Ask me anything about Grade ${grade}${stream ? " (" + stream + ")" : ""} — I'm here to help.`;
    setMessages([{ role: "assistant", content: greeting }]);
  }

  function goBack() {
    if (step === "chat" || step === "quiz-setup") setStep("mode");
    else if (step === "mode") setStep("subject");
    else if (step === "subject") setStep(needsStream ? "stream" : "grade");
    else if (step === "stream") setStep("grade");
    else if (step === "grade") setStep("medium");
    else if (step === "quiz-play" || step === "quiz-result") setStep("quiz-setup");
  }

  async function unlockWithCode() {
    const code = codeInput.trim();
    if (!code) return;
    setCodeError("Checking...");
    try {
      const response = await fetch("/api/redeem-code", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ code, phone }),
      });
      const data = await response.json();
      if (data.success) {
        setPlanState(prev => ({ ...prev, plan: data.plan, date: today, count: 0 }));
        setCodeError(""); setStep("medium");
      } else { setCodeError(data.message || "Invalid code."); }
    } catch (e) { setCodeError("Could not verify code. Check your connection and try again."); }
  }
  function continueFree() { setStep("medium"); }
  function selectMedium(m) { setMedium(m); setStep("grade"); }

  function handleFileSelect(e) {
    const file = e.target.files[0];
    if (!file) return;
    if (!isPaid) { alert("Attaching a screenshot is a Paid/Business plan feature. Please upgrade your plan first."); return; }
    const reader = new FileReader();
    reader.onload = () => { setImage({ base64: reader.result.split(",")[1], mediaType: file.type }); };
    reader.readAsDataURL(file);
  }

  async function sendMessage() {
    const text = input.trim();
    if ((!text && !image) || loading) return;
    if (!isPaid && questionsUsedToday >= FREE_DAILY_LIMIT) {
      setMessages(prev => [...prev, { role: "assistant", content: `You've used all ${FREE_DAILY_LIMIT} free questions for today. Try again tomorrow, or get the Paid plan for unlimited questions.` }]);
      return;
    }
    let contentForApi = text;
    if (image) {
      contentForApi = [
        { type: "image", source: { type: "base64", media_type: image.mediaType, data: image.base64 } },
        { type: "text", text: text || "Please solve the question/problem shown in this image." },
      ];
    }
    const newMessages = [...messages, { role: "user", content: contentForApi, _displayImage: image ? `data:${image.mediaType};base64,${image.base64}` : null, _displayText: text }];
    setMessages(newMessages); setInput(""); setImage(null); setLoading(true);

    if (!isPaid) {
      setPlanState(prev => ({ ...prev, plan: "free", date: today, count: questionsUsedToday + 1 }));
      fetch("/api/user", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ phone }) }).catch(() => {});
    }

    try {      const response = await fetch("/api/chat", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ system: buildSystemPrompt(grade, stream, subject, medium), messages: newMessages.map(m => ({ role: m.role, content: m.content })) }),
      });
      const data = await response.json();
      const textBlocks = (data.content || []).filter(b => b.type === "text").map(b => b.text).join("\n");
      if (textBlocks) { setMessages(prev => [...prev, { role: "assistant", content: textBlocks }]); }
      else { setMessages(prev => [...prev, { role: "assistant", content: "Sorry, something went wrong. Please try again." }]); }
    } catch (e) { setMessages(prev => [...prev, { role: "assistant", content: "Connection error. Please try again." }]); }
    finally { setLoading(false); }
  }

  // ---------- Quiz logic ----------
  function toggleMixedGrade(g) {
    setMixedGrades(prev => prev.includes(g) ? prev.filter(x => x !== g) : [...prev, g]);
  }

  async function generateQuiz() {
    setQuizError(""); setQuizLoading(true);
    let detail = scopeDetail;
    if (scopeType === "mixed") detail = mixedGrades.map(g => `Grade ${g}`).join(", ") || "all grades";
    if (scopeType === "full-book") detail = "";
    if ((scopeType === "chapter" || scopeType === "multi-chapter") && !scopeDetail.trim()) {
      setQuizError("Please enter chapter name(s)."); setQuizLoading(false); return;
    }
    if (scopeType === "mixed" && mixedGrades.length === 0) {
      setQuizError("Please select at least one grade."); setQuizLoading(false); return;
    }
    try {
      const response = await fetch("/api/generate-quiz", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ grade, stream, subject, scopeType, scopeDetail: detail, numQuestions, medium }),
      });
      const data = await response.json();
      if (data.success && Array.isArray(data.questions) && data.questions.length > 0) {
        setQuizQuestions(data.questions); setQuizIndex(0); setQuizSelected(null);
        setQuizCorrectCount(0); setQuizWrongCount(0); setQuizSessionCoins(0);
        setStep("quiz-play");
      } else { setQuizError(data.message || "Could not generate quiz. Try again."); }
    } catch (e) { setQuizError("Connection error. Please try again."); }
    finally { setQuizLoading(false); }
  }

  function answerQuiz(optionIndex) {
    if (quizSelected !== null) return;
    setQuizSelected(optionIndex);
    const correct = quizQuestions[quizIndex].correct;
    if (optionIndex === correct) {
      setQuizCorrectCount(c => c + 1); setQuizSessionCoins(c => c + 1);
      setCoinFeedback({ text: "+1 coin — Correct!", type: "pos" });
      addCoins(1);
    } else {
      setQuizWrongCount(c => c + 1); setQuizSessionCoins(c => c - 2);
      setCoinFeedback({ text: "-2 coins — Wrong", type: "neg" });
      addCoins(-2);
    }
  }

  function nextQuizQuestion() {
    setCoinFeedback(null);
    if (quizIndex + 1 < quizQuestions.length) { setQuizIndex(i => i + 1); setQuizSelected(null); }
    else { setStep("quiz-result"); }
  }

  return (
    <div className="shell">
      {step === "login" && (
        <div className="card"><div className="content">
          <h1>Welcome</h1>
          <div className="sub">Enter your phone number to continue.</div>
          <input className="codeinput" placeholder="03XX-XXXXXXX" value={phoneInput} onChange={e => setPhoneInput(e.target.value)} inputMode="numeric" />
          {loginError && <div style={{color:"var(--danger)", fontSize:12, marginTop:6}}>{loginError}</div>}
          <button className="primary-btn" style={{marginTop:14}} onClick={() => loginWithPhone(phoneInput)} disabled={checkingLogin}>
            {checkingLogin ? "Checking..." : "Continue"}
          </button>
          <div style={{fontSize:11.5, color:"var(--ink-soft)", marginTop:12}}>We use this to remember your plan, coins, and daily free questions across devices.</div>
        </div></div>
      )}

      {step === "plans" && (
        <div className="card"><div className="content">
          <div style={{display:"flex", justifyContent:"flex-end", marginBottom:4}}>
            <button className="back" onClick={logout}>Switch number</button>
          </div>
          <h1>Choose Your Plan</h1>
          <div className="sub">Pick the plan that fits your needs.</div>
          <div className="plans">
            <div className="plancard">
              <h3>Free</h3><div className="price">Rs. 0</div>
              <ul><li>{FREE_DAILY_LIMIT} questions per day</li><li>Text questions only</li><li>Every subject / grade</li></ul>
              <button onClick={continueFree}>Start Free</button>
            </div>
            <div className="plancard highlight">
              <h3>Paid</h3><div className="price">Rs. 300 / month</div>
              <ul><li>Unlimited questions</li><li>Ask by sending a screenshot</li><li>Priority answers</li></ul>
              <div className="paybox">EasyPaisa/JazzCash: <b>0346-7353181</b> (Account Name: <b>Kaif Siddique</b>) — send Rs. 300, then WhatsApp the payment screenshot to <b>0337-0123412</b> to get your unlock code.</div>
              <input className="codeinput" placeholder="Enter unlock code" value={codeInput} onChange={e => setCodeInput(e.target.value)} />
              {codeError && <div style={{color:"var(--danger)", fontSize:12, marginTop:6}}>{codeError}</div>}
              <button style={{marginTop:8}} onClick={unlockWithCode}>Unlock with Code</button>
            </div>
            <div className="plancard">
              <h3>Business</h3><div className="price">Custom pricing</div>
              <ul><li>For coaching centers / schools</li><li>Your own branding, bulk students</li><li>Contact us on WhatsApp to set up</li></ul>
              <button onClick={() => window.open('https://wa.me/923370123412','_blank')}>Chat on WhatsApp</button>
            </div>
          </div>
        </div></div>
      )}

      {step === "medium" && (
        <div className="card"><div className="content">
          <h1>Choose Your Medium</h1><div className="sub">How would you like your study buddy to explain things?</div>
          <div className="modegrid">
            <div className="modecard" onClick={() => selectMedium("english")}>
              <div className="icon">🇬🇧</div><div className="label">English Medium</div><div className="desc">Explanations fully in English</div>
            </div>
            <div className="modecard" onClick={() => selectMedium("urdu")}>
              <div className="icon">🇵🇰</div><div className="label">Urdu Medium</div><div className="desc">Explanations in Roman Urdu</div>
            </div>
          </div>
        </div></div>
      )}

      {step === "grade" && (
        <div className="card"><div className="content">
          <button className="back" onClick={goBack}>‹ Back</button>
          <h1 style={{marginTop:10}}>Choose Your Grade</h1><div className="sub">One tap to get started.</div>
          {GRADES.map(g => (
            <button className="option" key={g} onClick={() => selectGrade(g)}><span>Grade {g}</span><span className="chev">›</span></button>
          ))}
        </div></div>
      )}

      {step === "stream" && (
        <div className="card"><div className="content">
          <button className="back" onClick={goBack}>‹ Back</button>
          <h1 style={{marginTop:10}}>Choose Your Stream</h1><div className="sub">Which group are you in for Grade {grade}?</div>
          {STREAMS[grade].map(s => (
            <button className="option" key={s} onClick={() => selectStream(s)}><span>{s}</span><span className="chev">›</span></button>
          ))}
        </div></div>
      )}

      {step === "subject" && (
        <div className="card"><div className="content">
          <button className="back" onClick={goBack}>‹ Back</button>
          <h1 style={{marginTop:10}}>Choose Subject</h1><div className="sub">Subjects for Grade {grade}{stream ? " · " + stream : ""}</div>
          {subjectList.map(s => (
            <button className="option" key={s} onClick={() => selectSubject(s)}><span>{s}</span><span className="chev">›</span></button>
          ))}
        </div></div>
      )}

      {step === "mode" && (
        <div className="card"><div className="content">
          <button className="back" onClick={goBack}>‹ Back</button>
          <h1 style={{marginTop:10}}>{subject}</h1><div className="sub">Grade {grade}{stream ? " · " + stream : ""} — what would you like to do?</div>
          <div className="modegrid">
            <div className="modecard" onClick={startChat}>
              <div className="icon">💬</div><div className="label">Ask Questions</div><div className="desc">Chat and get step-by-step help</div>
            </div>
            <div className="modecard" onClick={() => { setScopeType("chapter"); setScopeDetail(""); setMixedGrades([]); setQuizError(""); setStep("quiz-setup"); }}>
              <div className="icon">🎯</div><div className="label">Take a Quiz</div><div className="desc">MCQs with coins & scoring</div>
            </div>
          </div>
        </div></div>
      )}

      {step === "quiz-setup" && (
        <div className="card"><div className="content">
          <button className="back" onClick={goBack}>‹ Back</button>
          <h1 style={{marginTop:10}}>Quiz Setup</h1><div className="sub">{subject} · Grade {grade}{stream ? " · " + stream : ""}</div>

          <div className="scopecard" style={scopeType==="chapter"?{}:{}} onClick={() => setScopeType("chapter")}>
            <div className={"t"} style={scopeType==="chapter"?{color:"var(--accent)"}:{}}>📘 Single Chapter</div>
            <div className="d">Quiz from one chapter or topic</div>
          </div>
          <div className="scopecard" onClick={() => setScopeType("multi-chapter")}>
            <div className="t" style={scopeType==="multi-chapter"?{color:"var(--accent)"}:{}}>📗 Multiple Chapters</div>
            <div className="d">Mix questions from up to 5 chapters</div>
          </div>
          <div className="scopecard" onClick={() => setScopeType("full-book")}>
            <div className="t" style={scopeType==="full-book"?{color:"var(--accent)"}:{}}>📚 Full Book</div>
            <div className="d">Covers the whole {subject} syllabus</div>
          </div>
          <div className="scopecard" onClick={() => setScopeType("mixed")}>
            <div className="t" style={scopeType==="mixed"?{color:"var(--accent)"}:{}}>🎓 Mixed Grades</div>
            <div className="d">Combine questions across grades</div>
          </div>

          {(scopeType === "chapter") && (
            <input className="textinput" placeholder="e.g. Chapter 5 - Force and Motion" value={scopeDetail} onChange={e => setScopeDetail(e.target.value)} />
          )}
          {(scopeType === "multi-chapter") && (
            <input className="textinput" placeholder="e.g. Chapter 1, Chapter 3, Chapter 5" value={scopeDetail} onChange={e => setScopeDetail(e.target.value)} />
          )}
          {(scopeType === "mixed") && (
            <div style={{display:"flex", gap:8, marginTop:6, flexWrap:"wrap"}}>
              {["9","10","11","12"].map(g => (
                <button key={g} className={"numbtn" + (mixedGrades.includes(g) ? " active" : "")} style={{flex:"0 0 auto", padding:"8px 16px"}} onClick={() => toggleMixedGrade(g)}>Grade {g}</button>
              ))}
            </div>
          )}

          <div style={{marginTop:16, fontWeight:700, fontSize:13, color:"var(--ink)"}}>Number of Questions</div>
          <div className="numrow">
            {[5,10,15].map(n => (
              <button key={n} className={"numbtn" + (numQuestions===n?" active":"")} onClick={() => setNumQuestions(n)}>{n}</button>
            ))}
          </div>

          {quizError && <div style={{color:"var(--danger)", fontSize:12.5, marginTop:12}}>{quizError}</div>}
          <button className="primary-btn" style={{marginTop:16}} onClick={generateQuiz} disabled={quizLoading}>
            {quizLoading ? "Generating Quiz..." : "Generate Quiz"}
          </button>
        </div></div>
      )}

      {step === "quiz-play" && quizQuestions.length > 0 && (
        <div className="card"><div className="content">
          <div className="quizprog">Question {quizIndex + 1} of {quizQuestions.length} · <span className="coinpill">🪙 {planState.coins || 0}</span></div>
          <div className="quizq">{quizQuestions[quizIndex].question}</div>
          {quizQuestions[quizIndex].options.map((opt, i) => {
            let cls = "quizopt";
            if (quizSelected !== null) {
              if (i === quizQuestions[quizIndex].correct) cls += " correct";
              else if (i === quizSelected) cls += " wrong";
            }
            return (
              <button key={i} className={cls} disabled={quizSelected !== null} onClick={() => answerQuiz(i)}>{opt}</button>
            );
          })}
          {coinFeedback && <div className={"coinfeedback " + (coinFeedback.type === "pos" ? "pos" : "neg")}>{coinFeedback.text}</div>}
          {quizSelected !== null && (
            <button className="primary-btn" style={{marginTop:8}} onClick={nextQuizQuestion}>
              {quizIndex + 1 < quizQuestions.length ? "Next Question" : "See Results"}
            </button>
          )}
        </div></div>
      )}

      {step === "quiz-result" && (
        <div className="card"><div className="content">
          <h1>Quiz Complete</h1>
          <div className="resultbig">{quizSessionCoins >= 0 ? "+" : ""}{quizSessionCoins} 🪙</div>
          <div className="sub" style={{textAlign:"center", marginBottom:8}}>coins earned this quiz</div>
          <div className="statrow"><span>Correct Answers</span><b style={{color:"var(--success)"}}>{quizCorrectCount}</b></div>
          <div className="statrow"><span>Wrong Answers</span><b style={{color:"var(--danger)"}}>{quizWrongCount}</b></div>
          <div className="statrow"><span>Total Coin Balance</span><b style={{color:"var(--gold)"}}>{planState.coins || 0} 🪙</b></div>
          <button className="primary-btn" style={{marginTop:18}} onClick={() => setStep("quiz-setup")}>Take Another Quiz</button>
          <button className="back" style={{marginTop:14, display:"block", textAlign:"center", width:"100%"}} onClick={() => setStep("mode")}>Back to Menu</button>
        </div></div>
      )}

      {step === "chat" && (
        <div className="card chatwrap">
          <div className="topbar">
            <button className="back" style={{color:"white"}} onClick={goBack}>‹ Back</button>
            <span style={{fontWeight:700}}>{subject} · Grade {grade}</span>
            <div style={{display:"flex", gap:6, alignItems:"center"}}>
              <span className="coinpill">🪙 {planState.coins || 0}</span>
              <span className="planpill">{isPaid ? planState.plan.toUpperCase() : "FREE"}</span>
            </div>
          </div>
          {!isPaid && <div className="limitnote">{Math.max(freeRemaining,0)} / {FREE_DAILY_LIMIT} free questions left today</div>}
          <div className="chatbody" ref={scrollRef}>
            {messages.map((m,i) => (
              <div key={i} className={`bubble ${m.role === "user" ? "user" : "bot"}`}>
                {m.role === "user" ? (m._displayText || (typeof m.content === "string" ? m.content : "")) : m.content}
                {m._displayImage && <img src={m._displayImage} alt="attachment" />}
              </div>
            ))}
            {loading && <div className="bubble bot"><div className="loadingdots"><span></span><span></span><span></span></div></div>}
          </div>
          <div className="inputrow" style={{flexDirection:"column", alignItems:"stretch"}}>
            {image && (
              <div className="thumb-wrap">
                <img src={`data:${image.mediaType};base64,${image.base64}`} alt="preview" />
                <button className="thumb-remove" onClick={() => setImage(null)}>×</button>
              </div>
            )}
            <div style={{display:"flex", gap:8}}>
              <input type="file" accept="image/*" ref={fileRef} style={{display:"none"}} onChange={handleFileSelect} />
              <button className="attachbtn" onClick={() => fileRef.current.click()} title="Attach screenshot">📎</button>
              <textarea rows="1" value={input} placeholder="Type your question..."
                onChange={e => setInput(e.target.value)}
                onKeyDown={e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(); } }} />
              <button className="sendbtn" onClick={sendMessage} disabled={loading || (!input.trim() && !image)}>➤</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);

if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("/sw.js").catch(() => {});
  });
}
</script>
</body>
</html>
